# Chat model (Chapters 2+)
# Chapter 2 introduces the Azure OpenAI-compatible endpoint and chat deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Native Foundry project path (Chapter 3)
# Chapter 3 uses these values for the project-endpoint provider path.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Embedding model for retrieval (Chapter 6)
